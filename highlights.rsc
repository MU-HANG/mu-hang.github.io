3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"我的划线 — 关于爱的问题"}],["$","meta","1",{"name":"description","content":"整理阅读《关于爱的问题》时留下的划线与批注。"}],["$","meta","2",{"name":"author","content":"邝杭"}],["$","meta","3",{"name":"robots","content":"noindex, nofollow"}],["$","meta","4",{"property":"og:title","content":"关于爱的问题"}],["$","meta","5",{"property":"og:description","content":"邝杭的《关于爱的问题》，以30个问题记录关于爱的追问与思考。从具体生活经验出发，结合不同学科视角，理解爱，也理解自己。"}],["$","meta","6",{"property":"og:url","content":"https://mu-hang.github.io"}],["$","meta","7",{"property":"og:site_name","content":"关于爱的问题"}],["$","meta","8",{"property":"og:type","content":"website"}],["$","meta","9",{"property":"og:locale","content":"zh_CN"}],["$","meta","10",{"property":"og:image","content":"https://mu-hang.github.io/og.png"}],["$","meta","11",{"property":"og:image:width","content":"1200"}],["$","meta","12",{"property":"og:image:height","content":"630"}],["$","meta","13",{"property":"og:image:alt","content":"关于爱的问题：慢慢读，也慢慢懂。"}],["$","meta","14",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","15",{"name":"twitter:title","content":"关于爱的问题"}],["$","meta","16",{"name":"twitter:description","content":"邝杭的《关于爱的问题》，以30个问题记录关于爱的追问与思考。从具体生活经验出发，结合不同学科视角，理解爱，也理解自己。"}],["$","meta","17",{"name":"twitter:image","content":"https://mu-hang.github.io/og.png"}],["$","link","18",{"data-vinext-streamed-icon":"$undefined","rel":"icon","href":"/icon.svg","type":"$undefined","sizes":"$undefined","color":"$undefined","media":"$undefined","fetchPriority":"$undefined"}],["$","link","19",{"rel":"canonical","href":"https://mu-hang.github.io/highlights/"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L6",null,{"fallback":"$7","children":["$","$L8",null,{"fallback":"$7","children":["$","$L9",null,{"providerId":"layout:/","segmentMap":{"children":["highlights"]},"children":["$","$La",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$Lb"