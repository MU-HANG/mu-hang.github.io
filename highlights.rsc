1:[["$","header",null,{"className":"site-nav","children":[["$","a",null,{"className":"brand","href":"/","children":["关于爱的问题",["$","span",null,{"children":"邝杭 · 关于爱的追问与思考"}]]}],["$","nav",null,{"aria-label":"主要导航","children":[["$","a",null,{"className":"nav-highlights","href":"/highlights/","children":"我的划线"}],["$","a",null,{"className":"nav-library","href":"/#library","children":["全部文章",["$","span",null,{"className":"nav-library-arrow","aria-hidden":"true","children":"↗"}]]}],["$","a",null,{"className":"nav-about","href":"/#about","children":"关于本文集"}],["$","a",null,{"className":"nav-start","href":"/articles/01/","children":"开始阅读 ↗"}]]}]]}],["$","$Le",null,{"articles":[{"id":"01","number":1,"title":"为什么我们总在爱中寻找缺失的自己？","description":"爱是填补内心的缺口，还是学会从两个人的位置看世界？","collection":"self","category":"认识自己","characters":8968,"minutes":20},{"id":"02","number":2,"title":"独处的能力是爱的入场券吗？","description":"在靠近另一个人之前，我们如何与自己的孤独相处。","collection":"self","category":"认识自己","characters":4533,"minutes":11},{"id":"03","number":3,"title":"我们爱的是性别，还是那个人？","description":"越过标签与预设，重新看见那个具体、独特的人。","collection":"self","category":"认识自己","characters":6676,"minutes":15},{"id":"04","number":4,"title":"自爱是一种自私，还是爱的起点？","description":"照顾自己与给予他人之间，是否真的存在一道分界。","collection":"self","category":"认识自己","characters":5389,"minutes":12},{"id":"05","number":5,"title":"“感觉”来了，然后呢？","description":"心动是故事的开端，之后的路需要我们共同走过。","collection":"encounter","category":"心动与靠近","characters":1763,"minutes":4},{"id":"06","number":6,"title":"浪漫爱是自然的，还是被发明的？","description":"从文学、文化与历史，回望我们习以为常的爱情想象。","collection":"encounter","category":"心动与靠近","characters":3224,"minutes":8},{"id":"07","number":7,"title":"为什么Crush比长久爱更令人上瘾？","description":"在不确定的期待与真实的亲密之间，理解心动的张力。","collection":"encounter","category":"心动与靠近","characters":5340,"minutes":12},{"id":"08","number":8,"title":"相似的人还是互补的人更适合？","description":"相似让人安心，差异令人着迷；关系如何走向长久。","collection":"encounter","category":"心动与靠近","characters":5373,"minutes":12},{"id":"09","number":9,"title":"确认关系的那一刻，我们到底在确认什么？","description":"一句“在一起”背后，是身份、承诺，也是共同的未来。","collection":"encounter","category":"心动与靠近","characters":6312,"minutes":15},{"id":"10","number":10,"title":"爱一个人，需要了解ta的全部吗？","description":"理解可以无限靠近，爱也需要尊重无法抵达的部分。","collection":"encounter","category":"心动与靠近","characters":7447,"minutes":17},{"id":"11","number":11,"title":"日常的重复会杀死爱情吗？","description":"当爱情落入一餐一饭，熟悉里是否还能生长出新的看见。","collection":"together","category":"相处的日常","characters":5362,"minutes":12},{"id":"12","number":12,"title":"爱中的妥协是牺牲，还是智慧？","description":"如何在“我们”之中，依然保留各自完整的自己。","collection":"together","category":"相处的日常","characters":5745,"minutes":13},{"id":"13","number":13,"title":"我们是在和对方恋爱，还是和手机里的对方恋爱？","description":"屏幕拉近了距离，也改变了我们相爱与相处的方式。","collection":"together","category":"相处的日常","characters":9198,"minutes":21},{"id":"14","number":14,"title":"爱需要被证明吗？仪式感是必需的吗？","description":"在礼物、纪念日与生活的细节中，寻找被看见的感觉。","collection":"together","category":"相处的日常","characters":7228,"minutes":17},{"id":"15","number":15,"title":"如何区分依赖与爱？","description":"“我需要你”与“我爱你”，是相似的声音，也是不同的关系。","collection":"together","category":"相处的日常","characters":8846,"minutes":20},{"id":"16","number":16,"title":"嫉妒是爱的证明，还是爱的不信？","description":"不安、占有与害怕失去，如何改变我们爱的方式。","collection":"parting","category":"裂痕与告别","characters":10537,"minutes":24},{"id":"30","number":17,"title":"为什么我们总在重复伤害与被伤害的模式？","description":"看见关系里反复上演的伤害，寻找走出旧有模式的可能。","collection":"parting","category":"裂痕与告别","characters":14776,"minutes":33},{"id":"17","number":18,"title":"爱与控制之间的那条线在哪里？","description":"从关心到干预，亲密关系中的自由与边界究竟在哪里。","collection":"parting","category":"裂痕与告别","characters":12141,"minutes":27},{"id":"18","number":19,"title":"背叛的废墟上，还能重建信任吗？","description":"当信任碎裂，理解修复所需要的时间、行动与承担。","collection":"parting","category":"裂痕与告别","characters":8156,"minutes":19},{"id":"19","number":20,"title":"爱会用尽吗？","description":"爱是一份会消耗的储备，还是一种可以不断生长的能力。","collection":"parting","category":"裂痕与告别","characters":6720,"minutes":15},{"id":"20","number":21,"title":"爱情的尽头是亲情，是一种堕落还是一种进化？","description":"激情与安稳的更替，如何重新塑造长久关系的意义。","collection":"parting","category":"裂痕与告别","characters":4573,"minutes":11},{"id":"21","number":22,"title":"我们分手，是因为不够爱，还是因为太爱自己？","description":"在离开的决定里，辨认爱、自我保护与选择的重量。","collection":"parting","category":"裂痕与告别","characters":4424,"minutes":10},{"id":"22","number":23,"title":"被分手的一方，恨的到底是什么？","description":"失去的不只是一个人，还有曾经相信的共同未来。","collection":"parting","category":"裂痕与告别","characters":4299,"minutes":10},{"id":"23","number":24,"title":"分手后还能做朋友，是一种释然还是一种逃避？","description":"在继续联结与真正放手之间，倾听自己的诚实答案。","collection":"parting","category":"裂痕与告别","characters":4542,"minutes":11},{"id":"24","number":25,"title":"爱有最好的时间吗？","description":"是遇见的时机决定了爱，还是爱让时机拥有了意义。","collection":"understanding","category":"重新理解爱","characters":4073,"minutes":10},{"id":"25","number":26,"title":"爱是与生俱来的能力，还是需要终身学习的技艺？","description":"从自然而然的心动，走向需要一生练习的看见与给予。","collection":"understanding","category":"重新理解爱","characters":4525,"minutes":11},{"id":"26","number":27,"title":"如果我们注定无法永远相爱，爱还有意义吗？","description":"承认爱的有限，是否反而让相遇的此刻更加珍贵。","collection":"understanding","category":"重新理解爱","characters":4776,"minutes":11},{"id":"27","number":28,"title":"爱是选择还是感觉？","description":"感觉让我们靠近，选择让我们一次次重新走向彼此。","collection":"understanding","category":"重新理解爱","characters":3858,"minutes":9},{"id":"28","number":29,"title":"爱他人，能教会我们如何爱这个世界吗？","description":"从看见一个具体的人开始，学会向更辽阔的世界敞开。","collection":"understanding","category":"重新理解爱","characters":3999,"minutes":9},{"id":"29","number":30,"title":"如果再来一次，我们还会选择爱吗？","description":"走过心动、相守与告别之后，再次面对最初的选择。","collection":"understanding","category":"重新理解爱","characters":3674,"minutes":9}]}],"$Lf"]
f:["$","footer",null,{"children":[["$","a",null,{"href":"/","children":"关于爱的问题"}],["$","span",null,{"children":"邝杭 著 · 慢慢读，也慢慢懂。"}]]}]
