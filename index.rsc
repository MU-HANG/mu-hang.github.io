10:["$","section",null,{"className":"library-section","data-scroll-scene":"library","id":"library","aria-labelledby":"library-title","children":[["$","div",null,{"className":"section-heading","data-reveal":"rise","children":[["$","div",null,{"children":[["$","p",null,{"className":"eyebrow","children":"THE COLLECTION · 文章集"}],["$","h2",null,{"id":"library-title","children":["每一个问题，",["$","span",null,{"children":"都值得停留。"}]]}]]}],["$","p",null,{"children":["30 篇文章，循着爱的轨迹，",["$","br",null,{}],"也可以从此刻的心情开始。"]}]]}],["$","$L14",null,{"articles":[{"id":"01","number":1,"title":"为什么我们总在爱中寻找缺失的自己？","description":"爱是填补内心的缺口，还是学会从两个人的位置看世界？","collection":"self","category":"认识自己","characters":8968,"minutes":20},{"id":"02","number":2,"title":"独处的能力是爱的入场券吗？","description":"在靠近另一个人之前，我们如何与自己的孤独相处。","collection":"self","category":"认识自己","characters":4533,"minutes":11},{"id":"03","number":3,"title":"我们爱的是性别，还是那个人？","description":"越过标签与预设，重新看见那个具体、独特的人。","collection":"self","category":"认识自己","characters":6676,"minutes":15},{"id":"04","number":4,"title":"自爱是一种自私，还是爱的起点？","description":"照顾自己与给予他人之间，是否真的存在一道分界。","collection":"self","category":"认识自己","characters":5389,"minutes":12},{"id":"05","number":5,"title":"“感觉”来了，然后呢？","description":"心动是故事的开端，之后的路需要我们共同走过。","collection":"encounter","category":"心动与靠近","characters":1763,"minutes":4},{"id":"06","number":6,"title":"浪漫爱是自然的，还是被发明的？","description":"从文学、文化与历史，回望我们习以为常的爱情想象。","collection":"encounter","category":"心动与靠近","characters":3224,"minutes":8},{"id":"07","number":7,"title":"为什么Crush比长久爱更令人上瘾？","description":"在不确定的期待与真实的亲密之间，理解心动的张力。","collection":"encounter","category":"心动与靠近","characters":5340,"minutes":12},{"id":"08","number":8,"title":"相似的人还是互补的人更适合？","description":"相似让人安心，差异令人着迷；关系如何走向长久。","collection":"encounter","category":"心动与靠近","characters":5373,"minutes":12},{"id":"09","number":9,"title":"确认关系的那一刻，我们到底在确认什么？","description":"一句“在一起”背后，是身份、承诺，也是共同的未来。","collection":"encounter","category":"心动与靠近","characters":6312,"minutes":15},{"id":"10","number":10,"title":"爱一个人，需要了解ta的全部吗？","description":"理解可以无限靠近，爱也需要尊重无法抵达的部分。","collection":"encounter","category":"心动与靠近","characters":7447,"minutes":17},{"id":"11","number":11,"title":"日常的重复会杀死爱情吗？","description":"当爱情落入一餐一饭，熟悉里是否还能生长出新的看见。","collection":"together","category":"相处的日常","characters":5362,"minutes":12},{"id":"12","number":12,"title":"爱中的妥协是牺牲，还是智慧？","description":"如何在“我们”之中，依然保留各自完整的自己。","collection":"together","category":"相处的日常","characters":5745,"minutes":13},{"id":"13","number":13,"title":"我们是在和对方恋爱，还是和手机里的对方恋爱？","description":"屏幕拉近了距离，也改变了我们相爱与相处的方式。","collection":"together","category":"相处的日常","characters":9198,"minutes":21},{"id":"14","number":14,"title":"爱需要被证明吗？仪式感是必需的吗？","description":"在礼物、纪念日与生活的细节中，寻找被看见的感觉。","collection":"together","category":"相处的日常","characters":7228,"minutes":17},{"id":"15","number":15,"title":"如何区分依赖与爱？","description":"“我需要你”与“我爱你”，是相似的声音，也是不同的关系。","collection":"together","category":"相处的日常","characters":8846,"minutes":20},{"id":"16","number":16,"title":"嫉妒是爱的证明，还是爱的不信？","description":"不安、占有与害怕失去，如何改变我们爱的方式。","collection":"parting","category":"裂痕与告别","characters":10537,"minutes":24},{"id":"30","number":17,"title":"为什么我们总在重复伤害与被伤害的模式？","description":"看见关系里反复上演的伤害，寻找走出旧有模式的可能。","collection":"parting","category":"裂痕与告别","characters":14776,"minutes":33},{"id":"17","number":18,"title":"爱与控制之间的那条线在哪里？","description":"从关心到干预，亲密关系中的自由与边界究竟在哪里。","collection":"parting","category":"裂痕与告别","characters":12141,"minutes":27},{"id":"18","number":19,"title":"背叛的废墟上，还能重建信任吗？","description":"当信任碎裂，理解修复所需要的时间、行动与承担。","collection":"parting","category":"裂痕与告别","characters":8156,"minutes":19},{"id":"19","number":20,"title":"爱会用尽吗？","description":"爱是一份会消耗的储备，还是一种可以不断生长的能力。","collection":"parting","category":"裂痕与告别","characters":6720,"minutes":15},{"id":"20","number":21,"title":"爱情的尽头是亲情，是一种堕落还是一种进化？","description":"激情与安稳的更替，如何重新塑造长久关系的意义。","collection":"parting","category":"裂痕与告别","characters":4573,"minutes":11},{"id":"21","number":22,"title":"我们分手，是因为不够爱，还是因为太爱自己？","description":"在离开的决定里，辨认爱、自我保护与选择的重量。","collection":"parting","category":"裂痕与告别","characters":4424,"minutes":10},{"id":"22","number":23,"title":"被分手的一方，恨的到底是什么？","description":"失去的不只是一个人，还有曾经相信的共同未来。","collection":"parting","category":"裂痕与告别","characters":4299,"minutes":10},{"id":"23","number":24,"title":"分手后还能做朋友，是一种释然还是一种逃避？","description":"在继续联结与真正放手之间，倾听自己的诚实答案。","collection":"parting","category":"裂痕与告别","characters":4542,"minutes":11},{"id":"24","number":25,"title":"爱有最好的时间吗？","description":"是遇见的时机决定了爱，还是爱让时机拥有了意义。","collection":"understanding","category":"重新理解爱","characters":4073,"minutes":10},{"id":"25","number":26,"title":"爱是与生俱来的能力，还是需要终身学习的技艺？","description":"从自然而然的心动，走向需要一生练习的看见与给予。","collection":"understanding","category":"重新理解爱","characters":4525,"minutes":11},{"id":"26","number":27,"title":"如果我们注定无法永远相爱，爱还有意义吗？","description":"承认爱的有限，是否反而让相遇的此刻更加珍贵。","collection":"understanding","category":"重新理解爱","characters":4776,"minutes":11},{"id":"27","number":28,"title":"爱是选择还是感觉？","description":"感觉让我们靠近，选择让我们一次次重新走向彼此。","collection":"understanding","category":"重新理解爱","characters":3858,"minutes":9},{"id":"28","number":29,"title":"爱他人，能教会我们如何爱这个世界吗？","description":"从看见一个具体的人开始，学会向更辽阔的世界敞开。","collection":"understanding","category":"重新理解爱","characters":3999,"minutes":9},{"id":"29","number":30,"title":"如果再来一次，我们还会选择爱吗？","description":"走过心动、相守与告别之后，再次面对最初的选择。","collection":"understanding","category":"重新理解爱","characters":3674,"minutes":9}],"collections":[{"id":"self","name":"认识自己","subtitle":"从理解自己开始，慢慢靠近爱。","range":[1,4]},{"id":"encounter","name":"心动与靠近","subtitle":"每一次相遇，都是一个新的问题。","range":[5,10]},{"id":"together","name":"相处的日常","subtitle":"在一餐一饭里，练习长久的在场。","range":[11,15]},{"id":"parting","name":"裂痕与告别","subtitle":"直面关系的难处，也照顾自己的心。","range":[16,24]},{"id":"understanding","name":"重新理解爱","subtitle":"走过之后，仍然愿意向世界敞开。","range":[25,30]}]}]]}]
11:["$","section",null,{"className":"closing-section","data-scroll-scene":"closing","id":"about","children":[["$","p",null,{"className":"eyebrow","data-reveal":"rise","children":"ABOUT THE COLLECTION · 关于本文集"}],["$","h2",null,{"data-reveal":"rise","children":["爱是一面",["$","br",null,{}],["$","span",null,{"children":"过于诚实的镜子。"}]]}],["$","p",null,{"className":"about-author","data-reveal":"rise","children":"邝杭 著"}],["$","div",null,{"className":"about-copy","children":[["$","p",null,{"data-reveal":"rise","children":"本文集记录了我关于爱的追问与思考，文集名为《关于爱的问题》。书中的三十个问题，覆盖了我认为从爱发生到结束的各个阶段，每一篇都从具体的生活经验出发，结合不同学科的视角，试图把那些模糊的、缠绕的感受梳理清楚，但是本文集不提供任何标准答案，也不传授恋爱技巧。"}],["$","p",null,{"data-reveal":"rise","children":"在写文章的时候，我忽然觉得，我们对爱的困惑，本质上是对自己的困惑。我们追问他为什么这样对我，其实是在问我为什么允许自己承受这些；我们焦虑他会不会离开我，其实是在恐慌我一个人能不能活。"}],["$","p",null,{"data-reveal":"rise","children":"爱是一面过于诚实的镜子，照出的从来不只是对方，还有我们自己。所以这三十个问题，说到底只是一个问题，即我该如何与自己相处，才能与他人真正相遇？"}],["$","p",null,{"data-reveal":"rise","children":"谨以此书，献给那些在爱中反复追问过自己的人，献给那些经历过心碎却仍愿意相信的人。"}],["$","p",null,{"data-reveal":"rise","children":"爱或许无法被彻底理解，但追问本身，已经是我们面对它的最好方式。"}]]}],["$","a",null,{"data-reveal":"rise","href":"/articles/29/","children":"读一读最终章：如果再来一次，我们还会选择爱吗？ ↗"}]]}]
15:T28fe,<p>笔者经历过爱情，在过往的经历中，笔者试图把爱情当做课题对待，以此观察她、书写她、更改她、润色她。笔者是一个并不太会去爱的一个人，所以笔者也试图思考如何成长、如何锻炼你的能力，而缺少的原因，笔者认为应该是青春期与成长时期的爱的得到并不多，家庭爱的确实导致的，正因为成长经历中缺少爱，我才想在未来历程中孕育爱。笔者是一个很慕强的人，也并不喜欢妥协，在爱情中肆意洒脱、常常信奉感觉，总觉得缘分很重要，缘来无论什么都要试试，缘去无论多爱都要离去，所以笔者又常常表现得多情，但就其根本，我一直在爱中寻找缺失的自己，多情并非滥情，而是因为不相信有真正笔者认为意义上的爱情，故而笔者也迷恋小说叙事、才子佳人的故事。</p>
<p>把爱情当做课题，是因为笔者在爱情的实践里，常常发觉自己和平时不一样，平时我大多是理性的、冷静的，而在爱情中，笔者感性万分，常常争风吃醋，矫揉造作，与我往日不同，故而，我想研究一下，爱何以改变。</p>
<p>选题的时候，笔者进行了调研以及大量的理论学习，在此感谢欧丽娟的红楼梦解析课程，让我初步了解了爱的理论、才子佳人理论以及推荐的书目，在文后笔者会罗列出来，供读者阅读。</p>
<p>选题的最初问题即是人，究竟如何与另一个有限、脆弱、终将消逝的生命，长久而真实地共处？</p>
<p>我把第一问放在缺失上，是因为几乎所有爱的故事都从这里开始。柏拉图的会饮篇里说，人本是完整的圆，被劈成两半后才终生寻找另一半，拉康说，自我本身就是一个镜像的构型，从来不是我们以为的那个整体。我们在镜子里看见一个残缺的自己，又在另一个人身上寻找能让自己完整的部分，于是爱很容易被误当成一种补全，我以为我爱你，其实我爱的是你身上恰好能填补我的那块缺口。这个系列想纠正的正是这一点。爱若只是补全，就永远逃不开你不够、我不够的怨怼，逃不开把对方当成工具的占有。所以紧接着谈独处的能力，温尼科特告诉我们，独处的能力是情感成熟的地基，一个无法安放自己的人，会把爱变成依附，把对方变成拐杖，但笔者也要强调，独处不是一张冷酷的入场券，不是你修好了自己才配被爱的判决，它更像一种可以被爱滋养、也反过来滋养爱的能力。独处与相爱不是先后两段，而是同一种在场的两面，人只有在能够独自站立时，才握得住另一个人伸来的手。</p>
<p>顺着这条线索，我一路追问了许多人们以为是常识、其实从未细想的问题。浪漫爱是自然的还是被发明的？我借《洛丽塔》那一树梨花压海棠的悖论与爱情史的考古说明我们以为天经地义的浪漫爱，很大程度上是被书籍、电影与消费文化发明出来的脚本，而脚本并不等于虚假，它只是提醒我们，爱的方式从来不是唯一。为什么 Crush 比长久爱更令人上瘾？因为 Crush 是精心设计的高强度间歇刺激，是永远停留在开始、永远不必深入的心动，而长久爱需要穿越平淡的勇气，我们许多人一生追逐 Crush 的灼热，却从未学会品尝相守的温热。相似的人还是互补的人更合适？确认关系的那一刻我们到底在确认什么？爱一个人需要了解他的全部吗，还是恰恰要保留他者不可穷尽的神秘？日常的重复会杀死爱情吗，我以为不会，杀死爱情的从来不是重复，而是麻木，是人在重复里停止了在场；海德格尔的此在、德勒兹的差异都在提醒我们，同一个动作，麻木地做是消耗，专注地做就成了仪式。爱中的妥协是牺牲还是智慧？嫉妒是爱的证明，还是爱的不信？我们为什么总在重复伤害与被伤害的模式，那是弗洛伊德所说的强迫性重复，是创伤在暗处替我们重演旧剧本，而看见它，是打断它的第一步。这些问题的答案，我都没有简单给出，因为它们本就没有简单的答案；我能做的，只是把每一盏灯点亮，让读者自己去看清脚下的路。</p>
<p>接着我们讨论背叛与分离。背叛的废墟上还能重建信任吗？笔者的回答是能，但永远回不到从前，德里达说宽恕只能宽恕那不可宽恕的，信任的重建不是抹去废墟，而是在废墟上重新打地基，让新的信任以另一种质地生长。我们分手，是因为不够爱，还是因为太爱自己？被分手的一方，恨的到底是什么？被分手者最深的痛，不是失去了这个人，而是过去被悬空，那些年、那些笑、那些共同度过的日子，仿佛因为结局的失败而全部失去了意义，像被白白经历了一遍。而分手后还能不能做朋友，与其问对方，不如问自己那是一份释然，还是一种不敢告别的逃避？爱与分离，从来不是爱的反面，而是爱的两种形态，正如一部书有开头，也必然有结尾，但我们不会因为书会读完，就拒绝翻开它。</p>
<p>如果要把这部书反复论证的结论收束为一句话，笔者想是这样，爱是与生俱来的种子，也是需要终身学习的技艺。与生俱来的，是感受的能力、联结的渴望、同理心的萌芽，是写在基因里的第一课；需要学习的，是让种子长成树的一切，倾听、看见、沟通、修复、相守、在平淡中依然选择。我们一生都在等待那棵大树自己长出来，却忘了树是要种的、水是要浇的，而那个种树、浇水、修剪、守护的过程本身，就是爱。我们最大的误会，是用坠入的容易，去推断站立的容易；用浪漫主义教给我们的爱是心不是脑，去拒绝承认爱是一门功课。于是当爱失败，我们归咎对象、时间、命运，却唯独不肯说一句，是我爱的能力还远远不够。而恰恰是这句不肯说的话，阻断了我们成长为更会爱的人。</p>
<p>也是在这条路上，笔者一遍遍想要拆开的，还有感觉与选择这对纠缠。感觉是爱的门，选择是爱的家。爱以不由自主的心动开始，情不知所起，一往而深，你无法命令自己爱上谁，也无法命令自己不爱上谁，但爱靠选择延续，在平淡、疲惫、失望的清晨，依然伸出手去握住对方的手。感觉是火，选择是灶；火让灶有了温度，灶让火得以持续。所谓成熟的爱，不是二选一，而是火在灶里，灶护着火，允许自己被感觉击中，然后选择去爱；选择去爱之后，再用行动去喂养感觉。我们许多人用选择阶段的标准苛求感觉阶段，又用感觉阶段的标准宣判选择阶段，于是在热恋褪去后的第一个寒冬，就抛弃了本可以用选择守护、用行动养大的爱。而所谓最好的时间，也从来不是日历上的某个点，Chronos 可以计算，Kairos 却只能感知；爱没有客观上最适合的年龄与阶段，只有两个心灵各自长到可以相遇的那个饱满时刻，而这个时刻不靠等待，靠在场，靠选择。你以为是命运赏给你的一张入场券，其实是你用每一个此刻的专注、每一次明知可能受伤仍伸出的手，亲手养成的。</p>
<p>如果我们注定无法永远相爱，爱还有意义吗？笔者的回答是有意义，而且恰恰因为不能永远，爱的意义才更需要被看见。因为爱不因永远而有意义，爱因真实而有意义，因它真实地发生过、真实地改变过你。世间好物不牢固，彩云易散琉璃碎，不牢固不是好物的缺陷，而是好物的本质；正因为知道它会散，你才在它还在的时候那样专注地看它。樱花的美，正在于它只开七天；天长地久有时尽，此恨绵绵无绝期，连永远本身都是不存在的，而正因为永远被否定了，爱留下的痕迹反而绵绵不绝。意义不在时长，而在深度；不在结局，而在过程把你变成了什么。爱过，就是死亡也无法夺走的、属于你一生的意义。</p>
<p>笔者还想说的是，爱一个人，是爱这个世界的一次预演。闭锁的爱，占有、依附、两人世界的堡垒，不会教会你爱世界，它只让你更容不下整个世界；而敞开的爱，那种看见他者、倾听他者、宽恕他者、珍惜他者之易碎的爱，教会你的每一件事，都是爱世界的功课。因为爱是一种态度，而非对某一个人的专有权；你若真的爱一个人，你就必然爱人类、爱生命、爱这个世界。那个人的房间，是世界的缩影；而世界，是无数个那样的人。你关起门来爱他，学会了爱；然后你推开门，把爱带向世界，不是为了不再爱他，而是因为你在爱他的过程中，学会了爱这个动作本身。</p>
<p>那么，如果再来一次，我们还会选择爱吗？这部书走到最后，给出的是一个绕了很远才抵达的答案，笔者认为是会的。不是因为爱不会受伤，而是因为不爱才是更大的遗憾。因为去爱，是这个不完美、会结束、注定有痛的世界上，最值得做的一件事，它是你在有限的生命里，做过的最接近永恒的动作。不是因为我们健忘，而是因为我们知道，在这个注定会失去一切的世界里，爱过，就是我们能带走的全部；而敢爱，就是我们能给自己的、最大的自由。</p>
<p>我深知这部书没有给出任何一劳永逸的答案。爱从来不是一个可以被解决的问题，它更像一场永远在途中、永远需要重新开始的远行，正如空空道人因空见色、由色生情、传情入色、自色悟空，情不是空的对面，情恰恰是通向悟的必经之路。倘若这部书所做的，不过是把关于爱的问题一盏一盏地点亮，让读到它的人在某个深夜里愿意停下来，想一想自己正在以怎样的状态去爱，那么我写下的这些文字，便也算没有辜负它们被写下的理由。</p>
<p>愿读到这里的你，敢爱，也懂得如何爱；愿你在每一个此刻，都完整地、在场地、真诚地活着。</p>
