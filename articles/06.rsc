1:[["$","a",null,{"href":"#reading-main","className":"skip-link","children":"跳转到正文"}],["$","header",null,{"className":"site-nav","children":[["$","a",null,{"className":"brand","href":"/","children":["关于爱的问题",["$","span",null,{"children":"邝杭 · 关于爱的追问与思考"}]]}],["$","nav",null,{"aria-label":"主要导航","children":[["$","a",null,{"className":"nav-library","href":"/#library","children":["全部文章",["$","span",null,{"className":"nav-library-arrow","aria-hidden":"true","children":"↗"}]]}],["$","a",null,{"href":"/#about","children":"关于本文集"}],["$","a",null,{"className":"nav-start","href":"/articles/01/","children":"开始阅读 ↗"}]]}]]}],["$","$Le",null,{"article":{"id":"06","number":6,"title":"浪漫爱是自然的，还是被发明的？","description":"从文学、文化与历史，回望我们习以为常的爱情想象。","collection":"encounter","category":"心动与靠近","characters":3224,"minutes":8},"articles":[{"id":"01","number":1,"title":"为什么我们总在爱中寻找缺失的自己？","description":"爱是填补内心的缺口，还是学会从两个人的位置看世界？","collection":"self","category":"认识自己","characters":8968,"minutes":20},{"id":"02","number":2,"title":"独处的能力是爱的入场券吗？","description":"在靠近另一个人之前，我们如何与自己的孤独相处。","collection":"self","category":"认识自己","characters":4533,"minutes":11},{"id":"03","number":3,"title":"我们爱的是性别，还是那个人？","description":"越过标签与预设，重新看见那个具体、独特的人。","collection":"self","category":"认识自己","characters":6676,"minutes":15},{"id":"04","number":4,"title":"自爱是一种自私，还是爱的起点？","description":"照顾自己与给予他人之间，是否真的存在一道分界。","collection":"self","category":"认识自己","characters":5389,"minutes":12},{"id":"05","number":5,"title":"“感觉”来了，然后呢？","description":"心动是故事的开端，之后的路需要我们共同走过。","collection":"encounter","category":"心动与靠近","characters":1763,"minutes":4},{"id":"06","number":6,"title":"浪漫爱是自然的，还是被发明的？","description":"从文学、文化与历史，回望我们习以为常的爱情想象。","collection":"encounter","category":"心动与靠近","characters":3224,"minutes":8},{"id":"07","number":7,"title":"为什么Crush比长久爱更令人上瘾？","description":"在不确定的期待与真实的亲密之间，理解心动的张力。","collection":"encounter","category":"心动与靠近","characters":5340,"minutes":12},{"id":"08","number":8,"title":"相似的人还是互补的人更适合？","description":"相似让人安心，差异令人着迷；关系如何走向长久。","collection":"encounter","category":"心动与靠近","characters":5373,"minutes":12},{"id":"09","number":9,"title":"确认关系的那一刻，我们到底在确认什么？","description":"一句“在一起”背后，是身份、承诺，也是共同的未来。","collection":"encounter","category":"心动与靠近","characters":6312,"minutes":15},{"id":"10","number":10,"title":"爱一个人，需要了解ta的全部吗？","description":"理解可以无限靠近，爱也需要尊重无法抵达的部分。","collection":"encounter","category":"心动与靠近","characters":7447,"minutes":17},{"id":"11","number":11,"title":"日常的重复会杀死爱情吗？","description":"当爱情落入一餐一饭，熟悉里是否还能生长出新的看见。","collection":"together","category":"相处的日常","characters":5362,"minutes":12},{"id":"12","number":12,"title":"爱中的妥协是牺牲，还是智慧？","description":"如何在“我们”之中，依然保留各自完整的自己。","collection":"together","category":"相处的日常","characters":5745,"minutes":13},{"id":"13","number":13,"title":"我们是在和对方恋爱，还是和手机里的对方恋爱？","description":"屏幕拉近了距离，也改变了我们相爱与相处的方式。","collection":"together","category":"相处的日常","characters":9198,"minutes":21},{"id":"14","number":14,"title":"爱需要被证明吗？仪式感是必需的吗？","description":"在礼物、纪念日与生活的细节中，寻找被看见的感觉。","collection":"together","category":"相处的日常","characters":7228,"minutes":17},{"id":"15","number":15,"title":"如何区分依赖与爱？","description":"“我需要你”与“我爱你”，是相似的声音，也是不同的关系。","collection":"together","category":"相处的日常","characters":8846,"minutes":20},{"id":"16","number":16,"title":"嫉妒是爱的证明，还是爱的不信？","description":"不安、占有与害怕失去，如何改变我们爱的方式。","collection":"parting","category":"裂痕与告别","characters":10537,"minutes":24},{"id":"30","number":17,"title":"为什么我们总在重复伤害与被伤害的模式？","description":"看见关系里反复上演的伤害，寻找走出旧有模式的可能。","collection":"parting","category":"裂痕与告别","characters":14776,"minutes":33},{"id":"17","number":18,"title":"爱与控制之间的那条线在哪里？","description":"从关心到干预，亲密关系中的自由与边界究竟在哪里。","collection":"parting","category":"裂痕与告别","characters":12141,"minutes":27},{"id":"18","number":19,"title":"背叛的废墟上，还能重建信任吗？","description":"当信任碎裂，理解修复所需要的时间、行动与承担。","collection":"parting","category":"裂痕与告别","characters":8156,"minutes":19},{"id":"19","number":20,"title":"爱会用尽吗？","description":"爱是一份会消耗的储备，还是一种可以不断生长的能力。","collection":"parting","category":"裂痕与告别","characters":6720,"minutes":15},{"id":"20","number":21,"title":"爱情的尽头是亲情，是一种堕落还是一种进化？","description":"激情与安稳的更替，如何重新塑造长久关系的意义。","collection":"parting","category":"裂痕与告别","characters":4573,"minutes":11},{"id":"21","number":22,"title":"我们分手，是因为不够爱，还是因为太爱自己？","description":"在离开的决定里，辨认爱、自我保护与选择的重量。","collection":"parting","category":"裂痕与告别","characters":4424,"minutes":10},{"id":"22","number":23,"title":"被分手的一方，恨的到底是什么？","description":"失去的不只是一个人，还有曾经相信的共同未来。","collection":"parting","category":"裂痕与告别","characters":4299,"minutes":10},{"id":"23","number":24,"title":"分手后还能做朋友，是一种释然还是一种逃避？","description":"在继续联结与真正放手之间，倾听自己的诚实答案。","collection":"parting","category":"裂痕与告别","characters":4542,"minutes":11},{"id":"24","number":25,"title":"爱有最好的时间吗？","description":"是遇见的时机决定了爱，还是爱让时机拥有了意义。","collection":"understanding","category":"重新理解爱","characters":4073,"minutes":10},{"id":"25","number":26,"title":"爱是与生俱来的能力，还是需要终身学习的技艺？","description":"从自然而然的心动，走向需要一生练习的看见与给予。","collection":"understanding","category":"重新理解爱","characters":4525,"minutes":11},{"id":"26","number":27,"title":"如果我们注定无法永远相爱，爱还有意义吗？","description":"承认爱的有限，是否反而让相遇的此刻更加珍贵。","collection":"understanding","category":"重新理解爱","characters":4776,"minutes":11},{"id":"27","number":28,"title":"爱是选择还是感觉？","description":"感觉让我们靠近，选择让我们一次次重新走向彼此。","collection":"understanding","category":"重新理解爱","characters":3858,"minutes":9},{"id":"28","number":29,"title":"爱他人，能教会我们如何爱这个世界吗？","description":"从看见一个具体的人开始，学会向更辽阔的世界敞开。","collection":"understanding","category":"重新理解爱","characters":3999,"minutes":9},{"id":"29","number":30,"title":"如果再来一次，我们还会选择爱吗？","description":"走过心动、相守与告别之后，再次面对最初的选择。","collection":"understanding","category":"重新理解爱","characters":3674,"minutes":9}],"children":"$Lf"}],"$L10"]
11:T26cb,<p>在阳光灿烂的沙滩上，一个穿着露脐上衣的女孩，正跪在沙地上，她的目光从她晒黑的肩上回望过来，落在我身上。那目光，像一道撕裂的闪电，将我前四十年的生命瞬间化为虚妄的灰烬。那是她，我的洛丽塔，她还在寻找她的暗礁，而我所需要的一切，都藏在那道回眸的影子里。</p>
<p>——《一树梨花压海棠》</p>
<p>黛玉一见，便吃一大惊，心下想道：“好生奇怪，倒像在那里见过一般，何等眼熟到如此！”……宝玉看罢，因笑道：“这个妹妹我曾见过的。”</p>
<p>——《红楼梦》</p>
<p>这是我最喜欢的两段关于“一见钟情”的表述，在文学中，我觉得一见钟情的爱最浪漫。</p>
<p>在文学创作中，浪漫爱像是一种宿命般的本能，是灵魂的久别重逢，是与生俱来的心灵共振。人类始终在文学与审美中，默认心动是天意，默契是天性，独一无二的羁绊是爱情最本真的模样。仿佛从古至今，人类天生就会向往一见钟情、灵魂契合、双向奔赴、至死不渝，心底自带一套完整的浪漫爱情模板，基于此我们长久将浪漫爱当作天性、当作本能、当作亘古不变的人类情感底色。</p>
<p>但是，思考之后笔者认为，我们今天信奉、追逐、渴求的浪漫爱，并不是天然存在的，它是被历史、文学、审美与时代文明，慢慢发明、塑造、建构出来的精神产物。</p>
<p>在论述之前，笔者还是需要定义一下何为浪漫爱？</p>
<p>所谓浪漫爱，区别于原始的情欲本能、世俗的婚恋契约与功利的生存结伴，是一种以个体情感为核心、以灵魂共鸣为追求、以独特偏爱与精神契合为内核的审美体系，它推崇纯粹的心动体验、独一无二的情感羁绊与超越现实功利的精神奔赴，是人类赋予亲密关系的高阶情感形态与审美范式。</p>
<p>基于以上定义，笔者先溯源一下浪漫爱之前的文学中爱的表述，是什么样子的？</p>
<p>传统婚恋体系里，两性结合大多不是个人情感的宣泄，而是家族延续、生存互助、伦理责任的载体。古人的情爱书写，多是别离的惦念、相守的忠贞、岁月的温良，鲜有现代人执着的非你不可、专属偏爱以及情绪共鸣。即便有缱绻情思，也藏于礼教与责任之下，克制而厚重。彼时没有戏剧化的心动剧本，没有仪式感的浪漫范式，人们相守一生，靠的是道义、包容、习性与责任，而非被后世文学渲染的极致浪漫与宿命情缘。</p>
<p>笔者认为，真正意义上的浪漫爱，是近代人文思潮与文学创作共同催生的文明产物，是一场彻底的审美革新与情感重构。它最早萌芽于中世纪欧洲骑士文学，贵族骑士对贵妇人纯粹的精神爱慕，剥离了婚姻的功利性与繁衍的本能性，首次将纯粹的情感体验置于两性关系的核心，打破了传统婚恋的实用主义桎梏。此后，文艺复兴解放个体意志，启蒙运动推崇自由情感，让爱情不再依附于礼教与家族。</p>
<p>而在华语文学语境中，浪漫爱的建构更具清晰的时代轨迹。古典文学的情爱多含蓄隐忍，直至明清戏曲完成了浪漫的初步觉醒，《牡丹亭》以“情不知所起，一往而深”，突破生死礼教，首次将个体深情凌驾于世俗规则之上，构建起情感至上的爱情审美。及至近现代，琼瑶系列言情小说风靡时代，彻底普及了心动即爱、偏爱即真、情绪至上的现代浪漫范式，让灵魂契合、宿命相逢、极致偏爱，成为几代人根深蒂固的爱情认知。至此，原本小众的文学审美，彻底下沉为全民的情感共识，现代浪漫爱的完整体系正式成型。</p>
<p>进入当代，消费社会与大众传媒，彻底完成了浪漫爱的标准化、模板化、规训化建构，让文学浪漫落地为全民情感准则，短视频、流行情歌、都市言情文不断细化浪漫的标准，比如细节、仪式、惊喜、专属、无条件偏爱。我们以为自己追随的是本心与本能，实则是一代代文学、影视、商业媒介，层层叠加、共同编撰的情感标准答案。我们追捧的心动瞬间、执着的浪漫仪式、渴求的灵魂契合，都不是天生的情感需求，而是被时代审美与文艺作品持续驯化、反复塑造出来的欲望。</p>
<p>它告诉我们爱必须浪漫、必须热烈、必须特殊、必须与众不同；爱要有心动的感觉、要有持续的偏爱、要有满满的仪式感；如果平淡、如果克制、如果朴素，便是不够爱。</p>
<p>笔者承认浪漫爱是被发明的、是被建构的，绝不等于笔者承认浪漫爱是假的。</p>
<p>很多人对此会陷入一种的误区，即一旦知道浪漫爱是后天建构，便觉得所有浪漫都是套路、所有心动都是渲染、所有深情都是文化催眠，进而否定爱情的真诚，陷入情感虚无与恋爱倦怠。可事实上，建构不代表虚假，被发明不代表无意义。人类文明中最珍贵的东西，大多都不是天然本能，而是人类自己发明、自己坚守、自己滋养出来的。</p>
<p>天然的本能是原始、粗粝、无差别的，是生物繁衍与浅层依恋的自然驱使；而建构性的浪漫，是人类剥离本能、超越世俗的文明诗意，是独属于人的精神创造。</p>
<p>野兽的相伴是生存本能，唯有人类，会在情爱中赋予生死奔赴的浪漫、灵魂契合的深刻、岁月相守的温柔。这份建构的价值，早已被千年文学印证：《牡丹亭》的情通生死，是人类对爱意超越世俗的主动赋义，古今无数诗词歌赋、戏曲小说，将平凡的相守、偶然的心动、长久的陪伴，淬炼为不朽的浪漫诗意。善良、正义、理想、诗意皆非天生，却构筑了人类的精神脊梁，浪漫爱亦是如此。它不是自然的本能，却是人类文明赠予亲密关系最珍贵的礼物。</p>
<p>浪漫爱不是虚假的滤镜，而是人类为平庸的亲密关系、为有限的人生，主动创造出的精神光芒。它不是欺骗，而是人类对亲密关系的主动升华。自然只教会我们彼此靠近、繁衍相伴，而浪漫教会我们欣赏、珍惜、包容、奔赴与救赎。自然给了我们相处的本能，而发明的浪漫，给了我们相爱的灵魂。</p>
<p>未经审视的浪漫，是盲从，是被文学剧本与大众叙事裹挟的自我内耗。太多人带着《灰姑娘》的童话期待、言情小说的完美人设、影视剧的热烈剧本去爱人，固执认为爱情必须有轰轰烈烈的开场、源源不断的惊喜、独一无二的偏爱。一旦现实落入平淡琐碎，没有戏剧化的心动，没有标准化的浪漫仪式，便轻易判定爱意消散、关系失效。很多人的情感痛苦，本质是用文学虚构的极致浪漫，苛责真实人间的朴素爱意，把后天建构的情感模板，错当成了与生俱来的爱情真理。</p>
<p>而当我们明白浪漫不是天生的标准答案，而是人类可以自主创造的温柔规则，我们便得以摆脱模板的束缚，拥有属于自己的爱的方式。</p>
<p>清醒的浪漫，是知其建构，而择其真诚；知其人为，而守其真心。</p>
<p>这种浪漫，首先需要去滤镜、去模板、去文艺盲从，不再沉溺于戏曲小说里生死相随的极致桥段，不再照搬影视剧本里千篇一律的浪漫套路，不再把刻意的仪式、夸张的情绪、极致的偏爱，当作真爱唯一的标尺。回望古典情爱，“平平淡淡才是真”的相守、“岁岁年年不相负”的笃定、“此时无声胜有声”的默契，亦是最动人的浪漫。真正的浪漫，从来不是复刻文学作品的虚构剧本，而是两个具体的人，剥离外界的审美规训，在烟火日常中，创造独属于彼此、不可复制的羁绊与温柔。</p>
<p>套路是时代建构的浪漫外壳，真诚是穿透所有文艺滤镜的永恒内核。</p>
<p>这种清醒的浪漫，是主动创造的而非被动等待的。庸俗的浪漫，是等待对方按照标准答案给自己制造惊喜、提供情绪价值、完成浪漫表演；而清醒的浪漫，是我们看透浪漫的人工属性后，依然愿意主动为生活赋义、为相处赋温、为陪伴赋情。</p>
<p>我们应该去知道世间本无天生的浪漫，是人的温柔、用心与珍惜，造就了浪漫。一句耐心的倾听、一次包容的让步、一场琐碎的陪伴、一份长久的坚守，这些脱离了商业模板与影视剧本的真实瞬间，才是最真诚、最持久的浪漫。</p>
<p>这种清醒的浪漫，更是接纳不完美，依然选择深耕。盲从的浪漫只能接受热烈与美好，无法承受平淡、矛盾、磨合与琐碎；而清醒的浪漫，是看清爱情没有天生圆满、没有永恒心动、没有剧本式完美，依然愿意认真对待、用心经营、双向奔赴。</p>
<p>所以，浪漫爱是被发明的，但爱从来不是假的。</p>
<p>自然给了人类彼此靠近、相伴相守的原始本能，千年文学与文明发明了浪漫的诗意与深情的范式，而我们以真诚、包容与坚守，为这份后天建构的浪漫，赋予了无可替代的真实。</p>
<p>最高级的浪漫，从来不是一无所知的天真憧憬，不是照搬书本剧本的刻意迎合，而是洞见浪漫的建构本质后，依然选择清醒热爱、用心奔赴。看透所有心动滤镜、所有文学渲染、所有时代规训，依然愿意和身边之人，褪去剧本、卸下套路，在平凡岁月里，亲手创造属于普通人最纯粹、最真诚的浪漫与余生。</p>
