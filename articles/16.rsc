1:[["$","a",null,{"href":"#reading-main","className":"skip-link","children":"跳转到正文"}],["$","header",null,{"className":"site-nav","children":[["$","a",null,{"className":"brand","href":"/","children":["关于爱的问题",["$","span",null,{"children":"邝杭 · 关于爱的追问与思考"}]]}],["$","nav",null,{"aria-label":"主要导航","children":[["$","a",null,{"className":"nav-library","href":"/#library","children":["全部文章",["$","span",null,{"className":"nav-library-arrow","aria-hidden":"true","children":"↗"}]]}],["$","a",null,{"href":"/#about","children":"关于本文集"}],["$","a",null,{"className":"nav-start","href":"/articles/01/","children":"开始阅读 ↗"}]]}]]}],["$","$Le",null,{"article":{"id":"16","number":16,"title":"嫉妒是爱的证明，还是爱的不信？","description":"不安、占有与害怕失去，如何改变我们爱的方式。","collection":"parting","category":"裂痕与告别","characters":10537,"minutes":24},"articles":[{"id":"01","number":1,"title":"为什么我们总在爱中寻找缺失的自己？","description":"爱是填补内心的缺口，还是学会从两个人的位置看世界？","collection":"self","category":"认识自己","characters":8968,"minutes":20},{"id":"02","number":2,"title":"独处的能力是爱的入场券吗？","description":"在靠近另一个人之前，我们如何与自己的孤独相处。","collection":"self","category":"认识自己","characters":4533,"minutes":11},{"id":"03","number":3,"title":"我们爱的是性别，还是那个人？","description":"越过标签与预设，重新看见那个具体、独特的人。","collection":"self","category":"认识自己","characters":6676,"minutes":15},{"id":"04","number":4,"title":"自爱是一种自私，还是爱的起点？","description":"照顾自己与给予他人之间，是否真的存在一道分界。","collection":"self","category":"认识自己","characters":5389,"minutes":12},{"id":"05","number":5,"title":"“感觉”来了，然后呢？","description":"心动是故事的开端，之后的路需要我们共同走过。","collection":"encounter","category":"心动与靠近","characters":1763,"minutes":4},{"id":"06","number":6,"title":"浪漫爱是自然的，还是被发明的？","description":"从文学、文化与历史，回望我们习以为常的爱情想象。","collection":"encounter","category":"心动与靠近","characters":3224,"minutes":8},{"id":"07","number":7,"title":"为什么Crush比长久爱更令人上瘾？","description":"在不确定的期待与真实的亲密之间，理解心动的张力。","collection":"encounter","category":"心动与靠近","characters":5340,"minutes":12},{"id":"08","number":8,"title":"相似的人还是互补的人更适合？","description":"相似让人安心，差异令人着迷；关系如何走向长久。","collection":"encounter","category":"心动与靠近","characters":5373,"minutes":12},{"id":"09","number":9,"title":"确认关系的那一刻，我们到底在确认什么？","description":"一句“在一起”背后，是身份、承诺，也是共同的未来。","collection":"encounter","category":"心动与靠近","characters":6312,"minutes":15},{"id":"10","number":10,"title":"爱一个人，需要了解ta的全部吗？","description":"理解可以无限靠近，爱也需要尊重无法抵达的部分。","collection":"encounter","category":"心动与靠近","characters":7447,"minutes":17},{"id":"11","number":11,"title":"日常的重复会杀死爱情吗？","description":"当爱情落入一餐一饭，熟悉里是否还能生长出新的看见。","collection":"together","category":"相处的日常","characters":5362,"minutes":12},{"id":"12","number":12,"title":"爱中的妥协是牺牲，还是智慧？","description":"如何在“我们”之中，依然保留各自完整的自己。","collection":"together","category":"相处的日常","characters":5745,"minutes":13},{"id":"13","number":13,"title":"我们是在和对方恋爱，还是和手机里的对方恋爱？","description":"屏幕拉近了距离，也改变了我们相爱与相处的方式。","collection":"together","category":"相处的日常","characters":9198,"minutes":21},{"id":"14","number":14,"title":"爱需要被证明吗？仪式感是必需的吗？","description":"在礼物、纪念日与生活的细节中，寻找被看见的感觉。","collection":"together","category":"相处的日常","characters":7228,"minutes":17},{"id":"15","number":15,"title":"如何区分依赖与爱？","description":"“我需要你”与“我爱你”，是相似的声音，也是不同的关系。","collection":"together","category":"相处的日常","characters":8846,"minutes":20},{"id":"16","number":16,"title":"嫉妒是爱的证明，还是爱的不信？","description":"不安、占有与害怕失去，如何改变我们爱的方式。","collection":"parting","category":"裂痕与告别","characters":10537,"minutes":24},{"id":"30","number":17,"title":"为什么我们总在重复伤害与被伤害的模式？","description":"看见关系里反复上演的伤害，寻找走出旧有模式的可能。","collection":"parting","category":"裂痕与告别","characters":14776,"minutes":33},{"id":"17","number":18,"title":"爱与控制之间的那条线在哪里？","description":"从关心到干预，亲密关系中的自由与边界究竟在哪里。","collection":"parting","category":"裂痕与告别","characters":12141,"minutes":27},{"id":"18","number":19,"title":"背叛的废墟上，还能重建信任吗？","description":"当信任碎裂，理解修复所需要的时间、行动与承担。","collection":"parting","category":"裂痕与告别","characters":8156,"minutes":19},{"id":"19","number":20,"title":"爱会用尽吗？","description":"爱是一份会消耗的储备，还是一种可以不断生长的能力。","collection":"parting","category":"裂痕与告别","characters":6720,"minutes":15},{"id":"20","number":21,"title":"爱情的尽头是亲情，是一种堕落还是一种进化？","description":"激情与安稳的更替，如何重新塑造长久关系的意义。","collection":"parting","category":"裂痕与告别","characters":4573,"minutes":11},{"id":"21","number":22,"title":"我们分手，是因为不够爱，还是因为太爱自己？","description":"在离开的决定里，辨认爱、自我保护与选择的重量。","collection":"parting","category":"裂痕与告别","characters":4424,"minutes":10},{"id":"22","number":23,"title":"被分手的一方，恨的到底是什么？","description":"失去的不只是一个人，还有曾经相信的共同未来。","collection":"parting","category":"裂痕与告别","characters":4299,"minutes":10},{"id":"23","number":24,"title":"分手后还能做朋友，是一种释然还是一种逃避？","description":"在继续联结与真正放手之间，倾听自己的诚实答案。","collection":"parting","category":"裂痕与告别","characters":4542,"minutes":11},{"id":"24","number":25,"title":"爱有最好的时间吗？","description":"是遇见的时机决定了爱，还是爱让时机拥有了意义。","collection":"understanding","category":"重新理解爱","characters":4073,"minutes":10},{"id":"25","number":26,"title":"爱是与生俱来的能力，还是需要终身学习的技艺？","description":"从自然而然的心动，走向需要一生练习的看见与给予。","collection":"understanding","category":"重新理解爱","characters":4525,"minutes":11},{"id":"26","number":27,"title":"如果我们注定无法永远相爱，爱还有意义吗？","description":"承认爱的有限，是否反而让相遇的此刻更加珍贵。","collection":"understanding","category":"重新理解爱","characters":4776,"minutes":11},{"id":"27","number":28,"title":"爱是选择还是感觉？","description":"感觉让我们靠近，选择让我们一次次重新走向彼此。","collection":"understanding","category":"重新理解爱","characters":3858,"minutes":9},{"id":"28","number":29,"title":"爱他人，能教会我们如何爱这个世界吗？","description":"从看见一个具体的人开始，学会向更辽阔的世界敞开。","collection":"understanding","category":"重新理解爱","characters":3999,"minutes":9},{"id":"29","number":30,"title":"如果再来一次，我们还会选择爱吗？","description":"走过心动、相守与告别之后，再次面对最初的选择。","collection":"understanding","category":"重新理解爱","characters":3674,"minutes":9}],"children":"$Lf"}],"$L10"]
11:T7c09,<p>七宗罪（SevenDeadlySins）是天主教教义中提出的七种人类恶行的总称，即所有不道德行为的根源性欲望。公元6世纪，其由教皇格里高利一世确立，后经托马斯·阿奎那在《神学大全》中系统化，按但丁《神曲》中的严重程度由重到轻排列为傲慢（Superbia/Pride）、嫉妒（Invidia/Envy）、暴怒（Ira/Wrath）、懒惰（Acedia/Sloth）、贪婪（Avaritia/Greed）、暴食（Gula/Gluttony）、色欲（Luxuria/Lust），其中嫉妒位列第二，嫉妒即因他人的优势而感到痛苦，并渴望将其夺走或贬低，与羡慕不同，嫉妒带有毁灭性，希望对方失去所拥有的美好，在《神曲》的《炼狱篇》中，嫉妒者的眼睑被铁丝缝合，象征其心灵已彻底丧失正视善意的能力，被困在自我编织的牢笼里，无法感受博爱的光芒。</p>
<p>但是，在爱情中的嫉妒，笔者认为不同于以上的论述。在爱情中，嫉妒无处不在，而它的地位却极其暧昧。一方面，在爱情叙事中，有一股神秘力量不断告诉我们嫉妒是因为在乎吃醋、是爱的表现、不嫉妒才是不爱；另一方面，几乎每个人都体验过嫉妒带来的痛苦那种心口被灼烧的感觉、那种彻夜难眠的胡思乱想、那种想质问又怕显得小气的纠结、以及嫉妒爆发后对关系造成的伤害。</p>
<p>故而，我们尝试思考，嫉妒到底是爱的证明，还是爱的不信？是我太爱你了所以才嫉妒，还是我不相信你爱我所以才嫉妒？如何回答它这一问题，决定了你如何应对嫉妒，如果你认为嫉妒是爱的证明，你就会倾向于允许甚至鼓励嫉妒，也会在自己嫉妒时感到理直气壮；如果你认为嫉妒是爱的不信，你就会把嫉妒当作一个需要被面对和处理的问题，而不是一种需要被合理化的情绪。</p>
<p>笔者认为，嫉妒不是爱的证明，而是爱的不信。因为它的核心不是我太爱你了，而是我不相信你会坚定地选择我，也不相信我值得被你坚定地选择。适度的、一闪而过的嫉妒是人之常情，它说明你在乎这段关系、在乎对方；但一旦嫉妒变成持续的焦虑、控制的冲动、惩罚的欲望，它就不再是爱的表达，而是不安全感和不信任的投射，它伤害的不仅是对方，更是你自己，以及你们之间的信任。嫉妒的真正对象从来不是第三者，而是我可能被取代的恐惧，其本质上是关于自我价值的焦虑，而不是关于对方忠诚的判断。</p>
<p>在讨论嫉妒与爱的关系之前，我们需要先厘清嫉妒到底是什么，因为这个词在日常使用中过于宽泛，有时指吃醋，有时指羡慕，有时指怨恨，而这些情绪虽然相关，但并不完全相同。</p>
<p>嫉妒与羡慕不同。羡慕是我想要你拥有的东西，羡慕的结构是二元的即分为主体（我）和客体（我想要的东西），而嫉妒是三元的，即分为主体（我）、所爱者（你）、竞争者（第三者）。嫉妒的核心不是想要第三者拥有的东西，而是我害怕第三者夺走我已经拥有的东西，即所爱者的爱和关注。嫉妒是由于看到他人拥有我们自己也想拥有的美好事物而产生的痛苦，但在亲密关系的语境中，</p>
<p>嫉妒可以被定义为当一个人感到自己与所爱者的关系受到真实或想象的第三者威胁时，所产生的一种混合了恐惧、愤怒、羞耻和悲伤的复杂情绪。</p>
<p>这个定义中有几个关键要素。</p>
<p>第一，嫉妒包含真实或想象的威胁。注意是真实或想象的很多时候，嫉妒的触发并不是因为对方真的有出轨行为，而是因为一些模糊的信号，这些信号本身可能完全无害，但在嫉妒者的眼中，它们被解读为威胁Ta是不是不爱我了？Ta是不是有别人了？</p>
<p>第二，嫉妒是一种混合情绪，而不是单一的情绪。它包含了①恐惧，即害怕失去对方、害怕被取代、害怕被抛弃；②愤怒，即对第三者的愤怒、对对方的愤怒、甚至对自己的愤怒；③羞耻，即为自己的嫉妒感到羞耻、为可能被背叛感到羞耻、为自己的不安全感感到羞耻；④悲伤，即为可能失去的关系感到悲伤、为我们不再像以前那样感到悲伤、为自己无法控制局面感到无力和悲伤。</p>
<p>这种情绪的混合性解释了为什么嫉妒如此令人痛苦它不是一种情绪在折磨你，而是四种情绪同时在撕扯你，而且它们往往相互矛盾，让你无法用一种简单的方式来应对。</p>
<p>第三，嫉妒的核心是关系的威胁感，而不是具体的第三者。很多人以为嫉妒的对象是第三者，但实际上，第三者只是嫉妒的触发器，不是嫉妒的核心。嫉妒的核心是我与所爱者的关系可能被破坏这种威胁感，第三者只是这种威胁感的具象化。即使没有具体的第三者，嫉妒也可能存在比如对方最近工作很忙、对你关注减少，你可能会嫉妒工作；对方把很多时间花在朋友身上，你可能会嫉妒朋友；对方有一个很亲密的爱好，你可能会嫉妒那个爱好。在这些情况下，没有第三者，但嫉妒依然存在，因为核心是我感到我在对方心中的位置被取代了不管取代我的是人、是事、还是物。</p>
<p>嫉妒者不是在嫉妒他人，而是在嫉妒自己，嫉妒的真正对象不是外部的竞争者，而是嫉妒者内在的某种东西一种我不够好、我可能被取代、我不值得被爱的内在信念。外部的第三者只是触发了这种内在信念，让它从潜意识的背景变成了意识的前景。所以，即使没有第三者，嫉妒者依然会找到威胁，因为威胁不是来自外部，而是来自内部。故而，我们可以更清晰地看到嫉妒不是一种简单的因为爱所以在乎的情绪，而是一种复杂的、混合的、核心是关系威胁感和自我价值焦虑的心理状态。</p>
<p>它的根源比爱深得多，也复杂得多。</p>
<p>接下里，我们尝试解剖一下为何会有嫉妒是爱的证明的这一观念。</p>
<p>嫉妒是爱的证明的逻辑是这样的，如果你不爱一个人，你就不会在乎Ta和谁在一起、不会在乎Ta是否关注你、不会在乎Ta是否可能离开你你根本无所谓。只有当你爱一个人的时候，Ta的行为才会对你产生影响，Ta的离开才会让你痛苦，Ta可能被别人夺走才会让你焦虑。</p>
<p>所以，嫉妒的存在本身就证明了爱的存在我嫉妒，是因为我在乎；我在乎，是因为我爱。</p>
<p>这个逻辑在一个层面上是对的，嫉妒确实意味着在乎。一个完全不在乎对方的人，不会产生嫉妒Ta对对方的行为漠不关心，对方和谁在一起、是否关注自己，都不会引发任何情绪波动。所以，嫉妒的出现确实说明这段关系对你有意义，对方对你有价值，你在乎这段关系的存续。在这个意义上，嫉妒是一个信号它告诉你了这段关系对你很重要，你需要关注它。但在乎不等于爱，这正是嫉妒是爱的证明这个逻辑的根本问题所在。在乎是爱的必要条件，但不是充分条件。你可以在乎一个人，但不是出于爱你可能是出于依赖（如第九章所论，我需要你因为没有你我活不下去），你可能是出于占有（你是我的，我不允许别人碰），你可能是出于自恋（你属于我证明了我的价值，如果你离开我就证明我没有价值），你可能是出于恐惧（我害怕孤独，害怕重新开始，害怕被别人议论）。在所有这些情况下，你都会在乎对方，都会在对方可能离开时感到焦虑和嫉妒，但这些都不是爱它们是依赖、占有、自恋、恐惧。</p>
<p>所以，嫉妒等于在乎等于爱这个推理链条，在第二步就断裂了，嫉妒确实意味着在乎，但在乎不一定意味着爱。你可以因为很多非爱的原因而在乎一个人，而这些原因同样会引发嫉妒。一个占有欲极强的人会因为伴侣和别人说话而嫉妒，但这不是爱，这是占有Ta把伴侣当作自己的财产，不允许别人觊觎。一个极度依赖的人会因为伴侣关注别人而嫉妒，但这不是爱，这是依赖Ta害怕失去唯一的支撑。一个自恋的人会因为伴侣欣赏别人而嫉妒，但这不是爱，这是自恋Ta感到自己的专属地位被挑战了。在所有这些情况下，嫉妒都存在，但爱并不存在，或者至少不是主要的驱动力。</p>
<p>而且，如果嫉妒等于爱，那么当你嫉妒的时候，你就不需要反思自己的嫉妒，我嫉妒是因为我爱你，这有什么错？当对方因为你的嫉妒而感到窒息和痛苦时，你可以用我是因为爱你来为自己辩护，比如我查你手机是因为我爱你、在乎你我限制你和异性来往是因为我害怕失去你，我因为你和别人多说了几句话而大发雷霆是因为我太爱你了。这种辩护把嫉妒从一个需要被审视的问题变成了一个不需要被质疑的爱的证明，从而让嫉妒者逃避了自我反思，也让被嫉妒者陷入了如果我反对Ta的嫉妒，就是在反对Ta的爱的道德困境中。</p>
<p>长此以往，嫉妒是爱的证明这个观念会毒化关系中的信任。如果嫉妒被当作爱的证明，那么不嫉妒就会被当作不爱的证据，这会演化为你都不为我吃醋，是不是不在乎我？你看到我和别人聊天都没反应，是不是不爱我了？这种逻辑会迫使双方表演嫉妒为了证明自己爱对方，你需要表现出嫉妒；为了让对方感到被爱，你需要允许甚至鼓励对方嫉妒。最终，关系变成了一场嫉妒的表演赛双方都在用嫉妒来证明爱，而真正的信任和安全感却在嫉妒的表演中被消耗殆尽。</p>
<p>所以，嫉妒是爱的证明这个观念，虽然包含了嫉妒意味着在乎这一部分真理，但它在根本上是误导性的它把在乎等同于爱，把嫉妒从一个需要被审视的情绪变成了一个不需要被质疑的证明，从而为控制和占有提供了合理化的外衣，也毒化了关系中的信任。</p>
<p>如果嫉妒不是爱的证明，那它是什么？笔者认为，嫉妒是爱的不信，它的核心是不信任，而不是爱。</p>
<p>这种不信有三个层面，即对对方的不信、对自己的不信、对关系的不信。</p>
<p>第一个层面是对对方的不信，不相信对方的忠诚和承诺。嫉妒者在内心深处不相信对方会坚定地选择自己、不相信对方会抵制诱惑、不相信对方的承诺是可靠的。这种不信可能源于对方过去的背叛行为，但更多时候，它源于嫉妒者自己的内在模式Ta倾向于把所有人都看作可能背叛的，把所有关系都看作可能破裂的，把所有模糊的信号都解读为背叛的预兆。这种不信不是基于对方的实际行为，而是基于嫉妒者自己的世界观，人都是不可信的关系、都是脆弱的人、都会出轨。在这种世界观下，对方的任何行为都可能被解读为不可信的证据Ta晚回家是有问题，Ta手机不离身是有秘密，Ta突然打扮自己是有情况。这种不信是自我实现的因为你不相信对方，你就会不断寻找证据，而只要你找，就总能找到，然后你就会用这些证据来证实你的不信。</p>
<p>第二个层面是对自己的不信，不相信自己值得被爱、不相信自己有不可替代的价值。嫉妒者在内心深处相信，我不够好，所以对方可能会离开我，去找一个更好的人。这种信念可能源于童年的经历比如父母经常说你不够好别人家的孩子比你强，或者在成长过程中经常被比较、被否定、被取代。它也可能源于过去的关系创伤比如曾经被伴侣背叛、被抛弃、被第三者取代。无论来源是什么，这种我不够好的信念会让嫉妒者在关系中始终处于一种防御性焦虑中，Ta时刻准备着被取代，时刻警惕着更好的人出现，时刻担心对方发现我不够好然后离开我。在这种状态下，任何竞争者的出现都会触发嫉妒，不是因为竞争者真的比你好，而是因为你内心深处已经相信有人会比我好，而对方会选择那个人而不是我。</p>
<p>第三个层面是对关系的不信，不相信关系本身是稳固的、可持续的、能够经受考验的。嫉妒者往往不相信关系可以在没有持续监控和控制的情况下保持忠诚，Ta认为，如果不盯着对方、不控制对方、不时刻确认对方的行踪，对方就一定会出轨。这种不信可能源于对人性的悲观看法（人都是经不起诱惑的），也可能源于对关系的脆弱性的过度感知（关系随时可能破裂，我必须时刻警惕）。这种不信导致嫉妒者把关系看作一个需要持续维护，但实际上是控制的脆弱物品，如果不时刻盯着，它就会碎掉，而这种时刻盯着本身就会破坏关系，因为信任是关系的基础，而监控和控制恰恰是不信任的表达，它会让对方感到不被信任、不被尊重，从而真的开始疏远关系，最终证实了嫉妒者的不信。</p>
<p>这三个层面的不信共同构成了嫉妒的本质。嫉妒不是我太爱你了，而是我不相信你会爱我，也不相信我值得被你爱，更不相信我们的关系能够稳固。在这个意义上，嫉妒确实与爱有关它发生在爱的语境中，它的对象是你爱的人但它不是爱的证明，而是爱的障碍。它不是因为爱所以嫉妒，而是因为爱，所以你的不信变得更加痛苦和明显，如果你不爱对方，你根本不会在乎Ta是否忠诚、是否关注你、是否会离开你；正因为你爱对方，你的不信才会引发如此强烈的痛苦和焦虑。但痛苦和焦虑的来源不是爱本身，而是爱中的不信是我爱你，但我不相信你也爱我这种撕裂感。</p>
<p>嫉妒作为一种情绪本身，即使是不健康的嫉妒，也不一定会直接伤害关系情绪是内在的，你可以感受到嫉妒，但不表现出来，或者表现出来但用建设性的方式处理。真正伤害关系的，是嫉妒从情绪演变为控制行为的过程。而这个演变之所以容易发生，正是因为嫉妒是爱的证明这个观念为控制提供了合理化的外衣。</p>
<p>让我们看看嫉妒是如何一步步从情绪演变为控制的。</p>
<p>①情绪的内化。当你第一次感到嫉妒时，它可能只是一阵刺痛，比如Ta和那个人聊得好开心，我有点不舒服。在这个阶段，嫉妒只是一个情绪信号，它告诉你我在乎这段关系，我感到了一点威胁。如果你在这个阶段能够觉察到自己的情绪，并问自己我为什么会有这种感觉？是对方的行为真的有问题，还是我自己的不安全感被触发了？那么嫉妒就停留在情绪层面，不会演变为控制。但如果你没有这种自我觉察，或者你把嫉妒直接等同于对方有问题，那么嫉妒就会进入下一步。</p>
<p>②行为的试探。在这个阶段，嫉妒开始外化为行为，但还不是直接的控制，你可能会不经意地问对方刚才和你聊天的那个人是谁？，你可能会在对方看手机时碰巧瞟一眼屏幕，你可能会在对方出门时顺便问一句去哪里？和谁？什么时候回来？这些行为看起来是关心，但实际上是试探你在收集信息，确认对方是否忠诚，评估威胁的程度。如果对方的回答让你满意嫉妒可能暂时平息；但如果对方的回答让你不满意，或者对方表现出不耐烦，嫉妒就会升级，进入下一步。</p>
<p>③直接的控制。在这个阶段，嫉妒不再掩饰自己，它直接表现为控制行为，你会要求对方不要和那个人来往，你要求对方手机随时让我看，你要求对方出门必须报备行踪，你要求对方删除所有异性好友，你要求对方社交账号密码告诉我。这些要求被包装成因为我爱你、在乎你、害怕失去你，但它们的本质是控制你试图通过限制对方的自由来消除自己的不安全感。在这个阶段，关系的权力结构已经发生了变化嫉妒者变成了控制者，被嫉妒者变成了被控制者，关系不再是两个平等主体之间的联结，而是一个主体对另一个主体的监视和约束。</p>
<p>④惩罚和报复。如果对方反抗控制或者控制没有达到预期效果（，嫉妒就可能演变为惩罚和报复，你可能会冷战、用言语攻击、用情感勒索甚至可能会以牙还牙。在这个阶段，嫉妒已经完全脱离了爱的范畴它不再是因为爱所以在乎，而是因为受伤所以报复；它的目标不再是维护关系，而是让对方也感受到我的痛苦。而惩罚和报复是关系的毒药它们会在双方心中留下伤痕，即使后来和好了，伤痕也依然存在，成为下一次嫉妒爆发的燃料。</p>
<p>这个演变过程的关键转折点，是嫉妒者是否把嫉妒的责任归咎于对方。如果嫉妒者认为我的嫉妒是因为对方的行为有问题，那么嫉妒就会外化为对对方的指责和控制；如果嫉妒者能够承认我的嫉妒主要是因为我自己的不安全感，那么嫉妒就会被内化为自我觉察和自我成长的契机。而嫉妒是爱的证明这个观念，恰恰鼓励了前者它让嫉妒者把嫉妒的责任推给对方（，从而逃避了自我觉察，也让控制变得理直气壮。</p>
<p>这里需要做一个重要的区分，如果对方真的有背叛行为，那么嫉妒是有现实基础的，它不是不信，而是知情后的合理反应。在这种情况下，问题不是嫉妒者的不安全感，而是对方的背叛行为。需要被处理的不是嫉妒者的情绪，而是对方的行为和关系中的信任危机。</p>
<p>本章讨论的嫉妒是爱的不信，主要针对的是没有现实背叛基础的、由内在不安全感驱动的嫉妒也就是对方并没有做什么越界的事，但嫉妒者依然持续地、过度地感到嫉妒和焦虑。</p>
<p>这两种情况需要被区分开来，否则就会陷入无论对方做了什么，嫉妒都是嫉妒者的问题这种对被背叛者不公的结论。</p>
<p>在批判了嫉妒是爱的证明并揭示了嫉妒的不信本质之后，笔者需要做一个平衡，因为不是所有的嫉妒都是不健康的，也不是所有的嫉妒都意味着不信。嫉妒作为一种人类普遍的情绪，有其存在的合理性和功能关键在于它的强度、频率、持续时间和行为后果。</p>
<p>嫉妒可以分为两种，即反应性嫉妒（reactivejealousy）和怀疑性嫉妒（suspiciousjealousy）。</p>
<p>反应性嫉妒是指当关系确实受到真实的外部威胁时所产生的嫉妒情绪。这种嫉妒是有现实基础的，它是对真实威胁的正常情绪反应，它的强度与威胁的程度大致匹配，它在威胁消除后会逐渐消退，它不会导致无根据的指控和过度的控制。反应性嫉妒是健康的，它是一个信号，告诉你这段关系出现了问题，需要被处理。在这种情况下，嫉妒不是爱的不信，而是对背叛的合理愤怒和痛苦。</p>
<p>怀疑性嫉妒是指在没有真实威胁的情况下，由内在的不安全感和不信任驱动的、持续的、过度的嫉妒和怀疑。这种嫉妒没有现实基础，对方并没有做什么越界的事，但嫉妒者依然不断地怀疑、监视、控制、指控。它的强度与实际情况不匹配，它的持续时间过长，会导致了破坏性的行为。怀疑性嫉妒是不健康的，它不是对真实威胁的反应，而是内在不安全感的投射；它不是爱的证明，而是爱的不信。</p>
<p>除了这种分类，我们还可以从体验的质量来区分健康和不健康的嫉妒。</p>
<p>健康的嫉妒是一闪而过的刺痛你看到对方和别人聊得开心，心里咯噔一下，有点不舒服，但你很快就能自我调节：</p>
<p>Ta有自己的社交很正常，我相信Ta，这没什么。这种嫉妒是轻微的、短暂的、可控的它不会占据你的整个心智，不会影响你的日常生活，不会导致对对方的指责和控制。它更像是一个温柔的提醒，即你在乎这段关系，记得多和对方联结。</p>
<p>不健康的嫉妒是吞噬一切的火焰，一旦被触发，它就会占据你的整个心智，让你无法思考其他事情，让你彻夜难眠，让你反复回想每一个可疑的细节，让你陷入</p>
<p>Ta是不是不爱我了、Ta是不是有别人了的死循环中无法自拔。这种嫉妒是强烈的、持续的、不可控的，它会影响你的工作、你的睡眠、你的情绪状态，更会影响你们的关系，你会因为嫉妒而对对方冷淡、指责、发脾气，你会因为嫉妒而做出让自己事后后悔的事，你会因为嫉妒而把对方越推越远。</p>
<p>健康的嫉妒指向关系它让你意识到我需要多关注这段关系，多和对方沟通，多表达我的感受和需求。它是建设性的它促使你去和对方谈我最近有点不安，我们能不能多花点时间在一起，而不是去指责对方你为什么和别人聊那么久。</p>
<p>不健康的嫉妒指向对方它让你觉得问题出在对方身上，是Ta的行为让我嫉妒，所以Ta需要改变。它是破坏性的它促使你去控制对方、指责对方、惩罚对方，而不是去反思自己的情绪和需求。</p>
<p>健康的嫉妒可以被沟通，你可以坦诚地告诉对方我刚才看到你和那个人聊得很开心，我有一点点嫉妒，我知道这可能是我的不安全感，但我想告诉你我的感受。这种沟通不会让对方感到被指控，反而会让对方感到被信任，从而促进双方的理解和联结。</p>
<p>不健康的嫉妒无法被沟通因为它的核心是不信任，而不信任是无法通过沟通来消除的，你越是试图沟通你的嫉妒，就越像是在指控对方我嫉妒是因为你做了让我嫉妒的事。最终，沟通变成了审问，表达感受变成了罗列罪状，关系在这种沟通中越来越紧张。</p>
<p>这个区分的意义在于我们不需要追求完全不嫉妒，因为那可能意味着不在乎，或者情感的隔离。适度的、反应性的、一闪而过的嫉妒是正常的、健康的，它说明你在乎这段关系，说明你是一个有情感的人。我们需要警惕和处理的，是那种持续的、怀疑性的、吞噬一切的、导致控制和破坏的嫉妒那种嫉妒不是爱的证明，而是爱的不信，是需要被面对和疗愈的内在创伤。</p>
<p>如果你发现自己的嫉妒更多是不健康的、怀疑性的、指向控制的，那么你可以从以下几个方向来与嫉妒共处，注意，是与嫉妒共处，而不是消灭嫉妒，因为适度的嫉妒是正常的，我们的目标不是变得完全不嫉妒，而是不让嫉妒控制我们、不被嫉妒驱动去做伤害关系的事。</p>
<p>第一是区分我的情绪和对方的行为。当嫉妒来临时，先停下来问自己对方真的做了什么越界的事吗？还是我自己的不安全感被触发了？如果对方确实有越界行为，那么问题是对方的行为，需要和对方严肃沟通、处理信任危机；如果对方并没有做什么越界的事，只是正常的社交和互动，那么你的嫉妒主要是自己的情绪它不是对方的错，而是你自己的不安全感在作祟。这个区分非常重要，因为它决定了你接下来的行动方向如果是对方的问题，你需要和对方沟通，如果是自己的情绪，你需要自我调节，而不是把情绪发泄到对方身上。很多关系中的矛盾，就是因为没有做这个区分把自己的不安全感引发的嫉妒，当成了对方行为不当的证据，从而指责和控制对方，最终伤害了关系。</p>
<p>第二是嫉妒来临时的自我追问。当你感到强烈的嫉妒时，不要立刻行动，先停下来，做几个深呼吸，然后问自己几个问题，我现在感受到了什么？是恐惧？愤怒？羞耻？悲伤？我害怕的到底是什么？是害怕失去对方？还是害怕自己不够好？还是害怕被别人取代？这个恐惧是基于事实的，还是基于我过去的经历？如果我的好朋友遇到同样的情况，我会怎么劝Ta？这些问题的目的，是把你从情绪驱动的行动模式切换到自我觉察的反思模式，当你开始反思自己的情绪时，情绪就失去了对你的直接控制，你就有了选择如何回应的空间。很多时候，仅仅是停下来问自己这个动作，就足以让嫉妒的强度下降一半因为你不再被情绪裹挟，而是开始看着情绪，而看着本身就创造了距离。</p>
<p>第三是建立内在的安全感。如前所述，嫉妒最深层的根源是我不够好、我不值得被爱的内在信念。所以，从根本上处理嫉妒，需要建立内在的安全感，相信自己是值得被爱的，相信自己有不可替代的价值，相信即使失去了这段关系，自己依然有能力好好生活。这种内在安全感的建立不是一朝一夕的事，它需要你在日常生活中不断地练习，去关注自己的优点和成就，发展自己的兴趣和能力，建立支持性的社交圈，练习自我关怀。当你的内在安全感足够强时，你就不会因为对方和别人多说了几句话就感到被取代的威胁，因为你知道，你的价值不取决于对方是否只关注你，你是一个独立的、有价值的人，无论对方是否关注你，你的价值都不会改变。</p>
<p>第四是用沟通代替审问。当你感到嫉妒，但又确定对方没有做越界的事时，你可以选择和对方沟通你的感受但要注意，是沟通感受，而不是审问对方。沟通感受的表达方式是，我最近有点不安、嫉妒，我知道这可能是我的问题，但我想告诉你我的感受，我们能不能多花点时间在一起、多聊聊彼此的近况？这种表达的核心是我我的感受、我的需求、我的脆弱，它没有指责对方，而是邀请对方一起理解和支持你。而审问的表达方式是你刚才和那个人聊什么聊那么久？你为什么最近回复我变慢了？你是不是有什么事瞒着我？这种表达的核心是你你的行为、你的可疑之处、你的错误，它让对方感到被指控和不信任，从而引发防御和反击。用沟通代替审问，不仅能避免伤害关系，还能促进双方的理解和联结当你坦诚地展示自己的脆弱时，对方更有可能给予你安慰、而不是因为被指控而防御和疏远。</p>
<p>第五是接受不确定性是关系的固有属性。最后，也是最根本的一点你需要接受，任何关系都包含不确定性你无法完全确定对方永远不会背叛你，无法完全确定关系永远不会破裂，无法完全控制对方的行为和选择。这种不确定性是关系的固有属性，不是你通过监控和控制就能消除的。试图通过控制来消除不确定性，只会让你陷入越控制越焦虑、越焦虑越控制的恶性循环因为控制永远无法达到百分百，而只要有百分之一的失控，你的焦虑就会被触发，然后你就会试图加强控制，而加强控制又会让对方感到窒息，从而真的开始疏远，最终证实了你的焦虑。打破这个循环的唯一方法，是接受不确定性，即我无法控制对方是否会背叛我，我只能做好我自己，信任对方，然后接受无论发生什么，我都有能力面对和处理。这种接受不是悲观，而是清醒和自由当你不再试图控制不可控的东西时，你就从焦虑的牢笼中解放了出来，你可以真正地享受关系，而不是时刻警惕着关系的破裂。</p>
<p>这些实践的共同核心是把注意力从控制对方转向安顿自己。嫉妒的痛苦，本质上是因为你把自己的安全感和价值感都寄托在了对方身上，对方关注你，你就感到安全和有价值；对方关注别人，你就感到被威胁和无价值。而安顿自己，就是把安全感和价值感的来源从外部（对方的关注和忠诚）转向内部（自己对自己的认可和信任）。当你能够安顿自己时，嫉妒就不再是一个需要通过控制对方来解决的问题，而是一个可以被观察、被理解、被温柔地安放的情绪它来了，你看着它，它走了，你继续生活。它不再控制你，也不再伤害你爱的人。</p>
<p>综上所述，笔者认为适度的、反应性的嫉妒是在乎的信号，它说明这段关系对你有意义；但持续的、过度的、怀疑性的嫉妒不是爱的证明，而是爱的不信它的核心是不信任，是不安全感，是我不相信你会坚定地选择我，也不相信我值得被你坚定地选择。</p>
<p>嫉妒不是爱的证明，因为在乎不等于爱你，也可以因为依赖、占有、自恋、恐惧而在乎一个人，这些都会引发嫉妒，但它们不是爱。嫉妒也不是爱的深度的指标嫉妒越强烈，不代表爱越深，只代表不安全感越强烈。一个真正自信、安全、信任对方和自己的人，在亲密关系中可能只会有轻微的、一闪而过的嫉妒，而不是持续的、吞噬一切的嫉妒这不是因为Ta爱得不够深，而是因为Ta不需要用嫉妒来证明爱，也不需要用控制来确保爱。</p>
<p>但嫉妒也不完全是坏事它可以是爱的功课。嫉妒的出现，是一个邀请，邀请你去面对自己内在的不安全感、不信任、无价值感；它是一面镜子，照出你在关系中的恐惧和脆弱；它是一个契机，让你从向外控制转向向内安顿，从要求对方证明爱转向自己成为值得被爱也能够去爱的人。</p>
<p>在这个意义上，嫉妒不是爱的证明，但它可以是爱的成长的催化剂，如果你愿意正视它、理解它、通过它来了解自己和成长，那么嫉妒的痛苦就不会白费，它会变成你走向更成熟、更自由、更信任的爱的道路上的一块垫脚石。</p>
<p>做到以上这些，你依然会有轻微的嫉妒因为你在乎对方，在乎这段关系；但你不会被嫉妒控制因为你信任对方，也信任自己，更信任你们的关系。当嫉妒来临时，你能觉察到它，能和它共处，能选择用建设性的方式来处理它，而不是被它驱动去做伤害关系的事。你不会用嫉妒来证明爱，也不会要求对方用让你不嫉妒来证明Ta的爱，因为你知道，爱不是通过消除嫉妒来证明的，而是通过日复一日的信任、尊重、理解和陪伴来实践的。</p>
<p>而当你能够达到这种状态时，嫉妒就不再是爱的障碍，而是爱的背景音它偶尔响起，提醒你在乎，但它不会盖过爱的主旋律。</p>
<p>爱的主旋律不是我害怕失去你，所以紧紧抓住你，而是我选择你，也允许你选择我，在这份自由中，我们每天都重新选择彼此。</p>
<p>在这样的爱里，嫉妒没有立足之地。</p>
<p>不是因为它被消灭了，而是因为它被超越了。</p>f:["$","div",null,{"dangerouslySetInnerHTML":{"__html":"$11"}}]
