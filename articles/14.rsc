3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"爱需要被证明吗？仪式感是必需的吗？ — 关于爱的问题"}],["$","meta","1",{"name":"description","content":"在礼物、纪念日与生活的细节中，寻找被看见的感觉。"}],["$","meta","2",{"name":"author","content":"邝杭"}],["$","meta","3",{"property":"og:title","content":"爱需要被证明吗？仪式感是必需的吗？"}],["$","meta","4",{"property":"og:description","content":"在礼物、纪念日与生活的细节中，寻找被看见的感觉。"}],["$","meta","5",{"property":"og:url","content":"https://mu-hang.github.io/articles/14/"}],["$","meta","6",{"property":"og:site_name","content":"关于爱的问题"}],["$","meta","7",{"property":"og:type","content":"article"}],["$","meta","8",{"property":"og:locale","content":"zh_CN"}],["$","meta","9",{"name":"twitter:card","content":"summary"}],["$","meta","10",{"name":"twitter:title","content":"爱需要被证明吗？仪式感是必需的吗？"}],["$","meta","11",{"name":"twitter:description","content":"在礼物、纪念日与生活的细节中，寻找被看见的感觉。"}],["$","link","12",{"data-vinext-streamed-icon":"$undefined","rel":"icon","href":"/icon.svg","type":"$undefined","sizes":"$undefined","color":"$undefined","media":"$undefined","fetchPriority":"$undefined"}],["$","link","13",{"rel":"canonical","href":"https://mu-hang.github.io/articles/14/"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L6",null,{"fallback":"$7","children":["$","$L8",null,{"fallback":"$7","children":["$","$L9",null,{"providerId":"layout:/","segmentMap":{"children":["articles","14"]},"children":["$","$La",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$Lb",null,{"resetKey":"articles","fallback":["$","main",null,{"className":"not-found","children":[["$","p",null,{"className":"eyebrow","children":"关于爱的问题"}],["$","h1",null,{"children":"这一页，暂时没有答案。"}],["$","p",null,{"children":"文章可能不在这个地址。回到目录，从另一个问题开始。"}],["$","a",null,{"href":"/#library","className":"pill-primary","children":["返回文章集 ",["$","span",null,{"children":"↗"}]]}]]}],"children":["$","$Lb",null,{"resetKey":"[\"articles\",\"id|14|d\"]","fallback":["$","main",null,{"c